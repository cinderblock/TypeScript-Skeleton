{
  "name": "library",
  "version": "0.0.0",
  "description": "Library for ...",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com> (https://cameron.tacklind.com)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "tsc",
    "test": "bun test src",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3"
  }
}
